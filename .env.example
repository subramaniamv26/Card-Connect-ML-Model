# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Oracle 19c (FreeSQL). Thin mode connects over TCPS with one-way TLS; no wallet is needed.
ORACLE_DSN=tcps://db.freesql.com:2484/19c_fy05s
ORACLE_USER=VIJUPRTHP_SCHEMA_NM6BK
ORACLE_PASSWORD=<CURRENT_PASSWORD>
ORACLE_POOL_MAX=4

# Long random secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_TTL_MINUTES=60
# true = an offer cannot be approved by the user who created or last edited it
REQUIRE_FOUR_EYES_APPROVAL=false

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=INFO
TRAINING_CRON_HOUR=2
TRAINING_CRON_MINUTE=0
API_PORT=8000
WEB_PORT=3000
IMAGE_TAG=1.0.0
