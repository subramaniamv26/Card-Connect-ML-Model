# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# Oracle connection (host:port/service). This is the SQL Developer connection "CC_ML".
ORACLE_DSN=localhost:1531/FREEPDB1
ORACLE_USER=cc_app
ORACLE_PASSWORD=<your cc_app password>

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<long random secret>

# Optional (defaults shown)
# TRAINING_CRON_HOUR=2          # daily training time, Asia/Colombo
# TRAINING_CRON_MINUTE=0
# JWT_TTL_MINUTES=60
# REQUIRE_FOUR_EYES_APPROVAL=false
# LOG_LEVEL=INFO
